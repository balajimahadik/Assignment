// 16. Find the Second Largest Number in an Array
// Input: [10, 20, 40, 30, 40] | Output: 30
// Finds the second-largest DISTINCT number.
function secondLargest(arr) {
    let unique = [...new Set(arr)]

    if (unique.length < 2) {
        return "No second largest number"
    }

    unique.sort((a, b) => b - a)

    return unique[1]
}
console.log(secondLargest([10, 20, 40, 30, 40]))


// 17. Find Common Elements Between Two Arrays
// Input: [1, 2, 3], [2, 3, 4] | Output: [2, 3]
function commonElements(arr1, arr2) {
    return [...new Set(arr1.filter(num => arr2.includes(num)))]
}
console.log(commonElements([1, 2, 3], [2, 3, 4]))


// 18. Sort an Array of Numbers in Ascending Order
// Input: [40, 10, 30, 20] | Output: [10, 20, 30, 40]
function sortArray(arr) {
    return [...arr].sort((a, b) => a - b)
}
console.log(sortArray([40, 10, 30, 20]))


// 19. Repeat a String n Times
// Input: "hi", 3 | Output: "hihihi"
function repeatString(str, n) {
    return str.repeat(n)
}
console.log(repeatString("hi", 3))


// 20. Check if All Characters in a String Are Unique
// Input: "hello" | Output: false
// Input: "world" | Output: true
function hasUniqueCharacters(str) {
    return new Set(str).size === str.length
}
console.log(hasUniqueCharacters("hello"))
console.log(hasUniqueCharacters("world"))
